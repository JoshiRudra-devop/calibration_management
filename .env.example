; Shreeji Instruments — Environment Template
; Copy this file to .env and fill in your values.
; See includes/config.php for usage.

; Database
DB_HOST=localhost
DB_USER=root
DB_PASS=your_database_password_here
DB_NAME=shreeji_instruments
DB_PORT=3306

; Cloudinary (find these in your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_UPLOAD_PRESET=shreeji_instruments

; Certificate PDF branding
CERT_COMPANY_NAME=SHREEJI INSTRUMENTS
CERT_COMPANY_TAGLINE=SALES • SERVICE • REPAIRING • CALIBRATIONS
CERT_CALIBRATOR_NAME=YOGESH BHAI
CERT_CALIBRATOR_TITLE=PROPRIETOR
CERT_CALIB_ORG=NATIONAL COUNCIL FOR CEMENT AND BUILDING MATERIALS
